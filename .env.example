# Copy to .env (git-ignored) or set these in your environment / hosting platform.

# "anthropic" calls Claude; "fixture" is the keyless offline demo (sample labels only).
LV_PROVIDER=anthropic
LV_ANTHROPIC_API_KEY=
LV_MODEL=claude-haiku-5-5
LV_EFFORT=low

# Optional: require this code before anyone can use the app (recommended for a public URL).
LV_ACCESS_CODE=
